# ==========================================
# Configuración Común - Entorno Local (Host)
# ==========================================
KAFKA_BROKERS=localhost:9092

# MongoDB (Replica Set rs0 de 1 nodo)
MONGO_URI_ACTIVATION=mongodb://localhost:27017/activation_db?replicaSet=rs0&directConnection=true
MONGO_URI_BILLING=mongodb://localhost:27017/billing_db?replicaSet=rs0&directConnection=true
MONGO_URI_PROVISIONING=mongodb://localhost:27017/provisioning_db?replicaSet=rs0&directConnection=true
MONGO_URI_NOTIFICATION=mongodb://localhost:27017/notification_db?replicaSet=rs0&directConnection=true
MONGO_URI_CRM=mongodb://localhost:27017/crm_db?replicaSet=rs0&directConnection=true

# Puertos de Servicios
PORT_ACTIVATION_API=3000

# Mailhog SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@telecom-poc.local
