{
  "name": "tp8-activacion-servicios-kafka",
  "version": "1.0.0",
  "private": true,
  "description": "POC Activación de Servicios con Kafka, NestJS y Patrón Saga Coreografiado",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "build": "pnpm -r build",
    "dev:all": "pnpm --parallel --filter \"./apps/*\" start:dev",
    "dev:phase1": "pnpm --parallel --filter activation-api --filter billing-service --filter provisioning-service start:dev",
    "dev:activation": "pnpm --filter activation-api start:dev",
    "dev:billing": "pnpm --filter billing-service start:dev",
    "dev:provisioning": "pnpm --filter provisioning-service start:dev",
    "dev:notification": "pnpm --filter notification-service start:dev",
    "dev:crm": "pnpm --filter crm-analytics-service start:dev",
    "dev:ui": "pnpm --filter demo-ui dev"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/microservices": "^10.4.4",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/websockets": "^10.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.7.0",
    "nodemailer": "^6.9.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^6.4.16",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core"
    ]
  }
}
